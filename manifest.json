{
  "manifest_version": "0.4",
  "name": "@nimblebraininc/bash",
  "version": "0.1.0",
  "description": "Execute bash commands via MCP",
  "author": {
    "name": "NimbleBrain Inc",
    "email": "hello@nimblebrain.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NimbleBrainInc/mcp-bash"
  },
  "server": {
    "type": "python",
    "entry_point": "mcp_bash.server",
    "mcp_config": {
      "command": "python",
      "args": [
        "-m",
        "mcp_bash.server"
      ]
    }
  },
  "tools": [
    {
      "name": "bash_exec",
      "description": "Execute a bash command and return stdout, stderr, exit code, and duration"
    }
  ],
  "_meta": {
    "org.mpaktrust": {
      "mtf_version": "0.1",
      "permissions": {
        "filesystem": "full",
        "network": "full",
        "environment": "read",
        "subprocess": "full",
        "native": "none"
      }
    }
  }
}
